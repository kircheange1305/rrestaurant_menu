<!doctype html>
<html lang="cs">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Přidat jídlo</title>
</head>
<body>
    <a href="/admin">Zpět na správu jídel</a>
    <h1>Přidat jídlo</h1>

    <form method="post" action="/admin/dishes/<%= dish.id %>/edit">
    <p>
        <label for="name">Název</label>
        <input id="name" name="name" value="<%= dish.name %>" maxlength="150" required>
    </p>
    <p>
        <label for="description">Popis</label>
        <textarea id="description" name="description"><%= dish.description ?? '' %></textarea>
    </p>
    <p>
        <label for="price">Cena (Kč)</label>
        <input id="price" name="price" type="number" min="0" step="0.01"
               value="<%= dish.price %>" required>
    </p>
    <p>
        <label for="category_id">Kategorie</label>
        <select id="category_id" name="category_id">
            <option value="" <%= dish.category_id === null ? 'selected' : '' %>>
                Bez kategorie
            </option>
            <% for (const category of categories) { %>
                <option value="<%= category.id %>"
                        <%= category.id === dish.category_id ? 'selected' : '' %>>
                    <%= category.name %>
                </option>
            <% } %>
        </select>
    </p>
    <button type="submit">Uložit změny</button>
</form>
</body>
</html>